+extern "C" {
+
+/*
+ * Rust code in the link (NVK's shader compiler, NAK) is built for
+ * aarch64-unknown-linux-gnu and reaches its thread-locals through TPIDR_EL0.
+ * libnx never sets that register (it uses TPIDRRO_EL0 and a soft thread
+ * pointer, -mtp=soft), so Rust TLS pointed at address 0 + offset: seen on
+ * console as a data abort at 0x2cd0 inside std::panicking (a NAK panic could
+ * not even report itself). Every thread now starts with TPIDR_EL0 = the libnx
+ * thread pointer, which is the base the linker laid the single TLS segment
+ * out against, for C and Rust alike.
+ */
+extern "C" void* __aarch64_read_tp(void);
+
+void RexSwitchSetHardwareTp() {
+  void* tp = __aarch64_read_tp();
+  __asm__ volatile("msr tpidr_el0, %0" : : "r"(tp));
+}
+
+struct TpStart {
+  ThreadFunc entry;
+  void* arg;
+};
+
+void TpTrampoline(void* p) {
+  const TpStart start = *static_cast<TpStart*>(p);
+  std::free(p);
+  RexSwitchSetHardwareTp();
+  start.entry(start.arg);
+}
+
+Result __wrap_threadCreate(Thread* t, ThreadFunc entry, void* arg, void* stack_mem,
+                           size_t stack_sz, int prio, int cpuid) {
+  Result rc;
+  if (auto* start = static_cast<TpStart*>(std::malloc(sizeof(TpStart)))) {
+    *start = {entry, arg};
+    rc = __real_threadCreate(t, TpTrampoline, start, stack_mem, stack_sz, prio, cpuid);
+    if (R_FAILED(rc)) {
+      std::free(start);
+    }
+  } else {
+    rc = __real_threadCreate(t, entry, arg, stack_mem, stack_sz, prio, cpuid);
+  }
+  if (R_SUCCEEDED(rc) && t) {
+    Register(t->handle);
+  }
+  return rc;
+}
+
+Result __wrap_threadClose(Thread* t) {
+  if (t) {
+    Unregister(t->handle);
+  }
+  return __real_threadClose(t);
+}
+
