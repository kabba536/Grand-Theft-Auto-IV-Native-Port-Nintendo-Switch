   }
+#if defined(__SWITCH__)
+  // Switch: also mirror the log to stderr, which switch_crash_hooks.c sends,
+  // unbuffered, to <NRO folder>/logs/rex/rex_stderr.log. It survives a hang
+  // or a forced power-off; the rotating file only has what was flushed.
+  if (!g_console_sink) {
