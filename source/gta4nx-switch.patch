+      }
+    }
+  }
+  if (frames > 0) {
+    std::fprintf(f,
+                 "     por fotograma: %.0f dibujados | tijera %.1f pantallas | %.1f envios | "
+                 "%.1f resolves (%.2f pantallas) | transferencias: %.1f llamadas, %.1f render "
